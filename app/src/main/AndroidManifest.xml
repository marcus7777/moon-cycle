            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Southern Hemisphere Aliases -->
        <activity-alias
            android:name="com.example.moon.MainActivityNewMoonS"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/moon_s_new"
            android:label="@string/app_name"
            android:targetActivity="com.example.moon.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
