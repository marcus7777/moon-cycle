        <activity-alias
            android:name="com.example.moon.MainActivityLastQuarter"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/moon_last_quarter"
            android:label="@string/app_name"
            android:targetActivity="com.example.moon.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
