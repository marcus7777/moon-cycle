<resources>
    <!-- Base theme -->
    <style name="Theme.MoonCycle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Pure black background for seamless transition -->
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- The icon is set per-alias in the manifest, but we provide a default -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/moon_full</item>
        <item name="postSplashScreenTheme">@style/Theme.MoonCycle</item>
    </style>
</resources>